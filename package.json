    "resend": "^6.0.0",
    "svelte": "^5.0.0",
    "svelte-dnd-action": "^0.9.0"
  },
  "devDependencies": {
    "@mmailaender/convex-svelte": "^0.18.0",
    "@sveltejs/kit": "^2.53.0",
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "svelte": "^5.53.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.4"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
