{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src/lib",
    "types": ["svelte"]
  },
  "include": ["src/lib/**/*.ts", "src/lib/**/*.svelte"],
  "exclude": ["node_modules", "dist"]
}
